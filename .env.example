# Where leads go
LEAD_TO_EMAIL=mike@mikemovers.com
LEAD_TO_PHONE=+15082156322

# Email (Resend) — turns on email to Mike + customer confirmation
RESEND_API_KEY=
LEAD_FROM_EMAIL=MJ Moving Company <quotes@YOUR-VERIFIED-DOMAIN>

# Text messages (Twilio) — turns on texts to Mike
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# or instead of TWILIO_FROM:
# TWILIO_MESSAGING_SERVICE_SID=

# Optional: instant phone alert with no carrier registration (Pushover app, one-time $5)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional: set to false to stop the customer confirmation email
# SEND_CUSTOMER_EMAIL=true
